# Editable style sheet for the extracted figures (16_06_26_make_figures.py).
# Edit these to control fonts/spines/sizes; pass a different file with --style.

# fonts — large axis & tick labels
font.size:          15
axes.titlesize:     14
axes.labelsize:     22
xtick.labelsize:    20
ytick.labelsize:    20
legend.fontsize:    16
figure.titlesize:   18

# clean axes
axes.spines.top:    False
axes.spines.right:  False
axes.linewidth:     1.3
xtick.major.size:   6
ytick.major.size:   6
xtick.major.width:  1.2
ytick.major.width:  1.2

# output
figure.dpi:         150
savefig.dpi:        150
savefig.bbox:       tight
legend.frameon:     False
